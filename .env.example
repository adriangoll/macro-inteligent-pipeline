# Variables de entorno de ejemplo para Macro Intelligence Pipeline.
# Copiar a .env y completar. No commitear el archivo .env real.

# Postgres / metadata de Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_UID=50000

# AWS (data lake S3 / Athena / Glue)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_DATA_LAKE_BUCKET=macro-intelligence-dev

# LLM Intelligence Layer
LLM_PROVIDER=claude
LLM_API_KEY=

# Fuentes de datos
FRED_API_KEY=

# Streamlit
STREAMLIT_SERVER_PORT=8501
